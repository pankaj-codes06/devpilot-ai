{
  "name": "devpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "DevPilot AI — Autonomous GitHub Developer Agent",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@devpilot/api",
    "dev:web": "npm run dev --workspace=@devpilot/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .js,.jsx,.cjs",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "db:generate": "npm run generate --workspace=@devpilot/database",
    "db:migrate": "npm run migrate:dev --workspace=@devpilot/database",
    "db:push": "npm run push --workspace=@devpilot/database",
    "db:studio": "npm run studio --workspace=@devpilot/database"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "prettier": "^3.9.10",
    "typescript": "^5.4.5"
  }
}
