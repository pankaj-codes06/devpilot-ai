datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TriggerType {
  SCHEDULED
  MANUAL
  WEBHOOK
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

model User {
  id             String       @id @default(cuid())
  email          String?      @unique
  name           String?
  avatarUrl      String?
  githubId       BigInt       @unique
  githubUsername String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships    TeamMember[]
  auditLogs      AuditLog[]

  @@index([githubId])
  @@index([githubUsername])
  @@map("users")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  githubOrgId BigInt?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members      TeamMember[]
  repositories Repository[]
  auditLogs    AuditLog[]

  @@index([slug])
  @@map("organizations")
}

model TeamMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           TeamRole     @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  moduleOwnerships TeamModule[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("team_members")
}

model Repository {
  id             String         @id @default(cuid())
  organizationId String
  githubRepoId   BigInt         @unique
  installationId BigInt
  name           String
  fullName       String         @unique
  owner          String
  isPrivate      Boolean        @default(false)
  htmlUrl        String
  defaultBranch  String         @default("main")
  description    String?
  isConnected    Boolean        @default(true)
  connectedAt    DateTime       @default(now())
  lastSyncedAt   DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentSettings  AgentSettings?
  modules        TeamModule[]
  agentRuns      AgentRun[]
  pullRequests   PullRequest[]
  commitRecords  CommitRecord[]
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@index([installationId])
  @@index([githubRepoId])
  @@index([isConnected])
  @@map("repositories")
}

model TeamModule {
  id             String       @id @default(cuid())
  repositoryId   String
  name           String
  description    String?
  pathPattern    String
  ownerId        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  repository     Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  owner          TeamMember?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@index([ownerId])
  @@map("team_modules")
}

model AgentSettings {
  id               String       @id @default(cuid())
  repositoryId     String       @unique
  isEnabled        Boolean      @default(false)
  scheduleCron     String       @default("0 9 * * 1-5")
  timezone         String       @default("Asia/Kolkata")
  branchPrefix     String       @default("devpilot/")
  allowedPaths     String[]     @default([])
  excludedPaths    String[]     @default([".github/**", "docker/**", "docker-compose.yml", ".env*"])
  maxDailyRuns     Int          @default(3)
  requirePrReview  Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  repository       Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([isEnabled])
  @@map("agent_settings")
}

model AgentRun {
  id             String          @id @default(cuid())
  repositoryId   String
  triggerType    TriggerType     @default(SCHEDULED)
  status         ExecutionStatus @default(QUEUED)
  startedAt      DateTime?
  completedAt    DateTime?
  summary        String?
  errorLog       String?
  commitHash     String?
  pullRequestId  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  repository     Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  pullRequest    PullRequest?    @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  tasks          AgentTask[]
  commits        CommitRecord[]

  @@index([repositoryId])
  @@index([status])
  @@index([createdAt])
  @@map("agent_runs")
}

model AgentTask {
  id          String     @id @default(cuid())
  agentRunId  String
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  order       Int        @default(0)
  output      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  agentRun    AgentRun   @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@index([status])
  @@map("agent_tasks")
}

model CommitRecord {
  id           String     @id @default(cuid())
  repositoryId String
  agentRunId   String?
  sha          String
  message      String
  branch       String
  authorName   String
  authorEmail  String
  committedAt  DateTime
  createdAt    DateTime   @default(now())

  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?  @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@unique([repositoryId, sha])
  @@index([repositoryId])
  @@index([agentRunId])
  @@index([sha])
  @@map("commit_records")
}

model PullRequest {
  id             String           @id @default(cuid())
  repositoryId   String
  githubPrNumber Int
  title          String
  body           String?
  state          PullRequestState @default(OPEN)
  headBranch     String
  baseBranch     String
  htmlUrl        String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  repository     Repository       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  agentRuns      AgentRun[]

  @@unique([repositoryId, githubPrNumber])
  @@index([repositoryId])
  @@index([state])
  @@map("pull_requests")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  repositoryId   String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  repository     Repository?  @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([repositoryId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

