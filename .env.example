# DevPilot AI — Environment Configuration
# Copy this file to .env before starting the application: cp .env.example .env

# ==============================================================================
# Database & Cache Configuration
# ==============================================================================
# PostgreSQL Connection URL
DATABASE_URL="postgresql://devpilot:devpilot_secret@localhost:5432/devpilot_db?schema=public"

# Redis Connection URL (For background job queues & caching)
REDIS_URL="redis://localhost:6379"

# ==============================================================================
# GitHub OAuth App (Used for user authentication & sign-in)
# ==============================================================================
# Create at: GitHub Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==============================================================================
# GitHub App (Used for repository installation, permissions, and webhook events)
# ==============================================================================
# Create at: GitHub Settings -> Developer settings -> GitHub Apps -> New GitHub App
# GitHub App ID (numeric integer found on app general page)
GITHUB_APP_ID=

# GitHub App Slug / URL name (e.g., "devpilot-ai")
GITHUB_APP_SLUG=

# GitHub App RSA Private Key (PEM format). Can be inline with \n escapes or path to .pem file
# Example: "-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=

# GitHub Webhook Secret (used to verify HMAC-SHA256 signatures on incoming webhook payloads)
GITHUB_WEBHOOK_SECRET=

# ==============================================================================
# Application & Session Configuration
# ==============================================================================
# 32+ character secret for signing HTTP-only session cookies and CSRF tokens
SESSION_SECRET=devpilot_secure_random_session_secret_change_in_production_min_32_chars

# Application base URL (Frontend user-facing URL)
APP_URL=http://localhost:3000

# Backend API server URL
API_URL=http://localhost:4000

# Frontend URL (For CORS whitelist and redirection)
FRONTEND_URL=http://localhost:3000

# Server Port
PORT=4000

# Node Environment
NODE_ENV=development

# Default Timezone
DEFAULT_TIMEZONE=Asia/Kolkata

